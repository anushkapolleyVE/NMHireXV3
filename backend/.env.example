# ---------------------------------------------------------
# DATABASE
# ---------------------------------------------------------
DATABASE_URL=postgresql://postgres:password@localhost:5432/nmhirex

# ---------------------------------------------------------
# AUTHENTICATION
# ---------------------------------------------------------
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---------------------------------------------------------
# KEY 1: WHATSAPP MESSAGING (PERMISSION: SEND MESSAGES ONLY)
# ---------------------------------------------------------
WHATSAPP_MESSAGE_API_KEY=wa_live_messagingKeyId_messagingSecret
WHATSAPP_API_KEY=wa_live_messagingKeyId_messagingSecret
WHATSAPP_BASE_URL=https://nmve.io/whatsapp/api/integrations/whatsapp/messages
WHATSAPP_STAGE_NUMBER=7439717970

# ---------------------------------------------------------
# KEY 2: WHATSAPP INTEGRATION GATEWAY (PERMISSION: GENERATE TEST URL FROM /addcandidates)
# ---------------------------------------------------------
# Gateway base URL (no trailing slash)
NMHIREX_GATEWAY_URL=https://nmve.io/whatsapp
# API Key in the format: wa_live_<keyId>_<secret> (Used strictly for /addcandidates, schedules, results)
NMHIREX_GATEWAY_API_KEY=wa_live_gatewayKeyId_gatewaySecret
NMHIREX_API_KEY=wa_live_gatewayKeyId_gatewaySecret
# Request timeout in seconds (15-30s)
NMHIREX_GATEWAY_TIMEOUT_SECONDS=25
# Default Requisition ID fallback
NMHIREX_DEFAULT_REQUISITION_ID=506

# ---------------------------------------------------------
# FRONTEND / CORS
# ---------------------------------------------------------
FRONTEND_URL=http://localhost:5173

