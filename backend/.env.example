# Database Connection String (e.g. Neon, Supabase, AWS RDS PostgreSQL)
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Frontend URL (Your Vercel deployment URL, e.g. https://your-app.vercel.app)
FRONTEND_URL=https://your-frontend.vercel.app

# WhatsApp / NMVE Configuration
WHATSAPP_API_KEY=your_whatsapp_live_api_key
WHATSAPP_BASE_URL=https://nmve.io/whatsapp/api/integrations/whatsapp/messages
WHATSAPP_STAGE_NUMBER=7439717970
WHATSAPP_TEMPLATE_NAME=candidate_shortlisted_outreach
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_COMPANY_NAME=Acme
WHATSAPP_CALLBACK_URL=https://your-backend.onrender.com/api/webhooks/whatsapp

# WhatsApp Test Mode (False = send to real candidate numbers; True = send only to test number)
WHATSAPP_TEST_MODE=False
WHATSAPP_TEST_NUMBER=917439717970

# Authentication
JWT_SECRET_KEY=your_generated_jwt_secret_key_here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
