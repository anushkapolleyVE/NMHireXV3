# ---------------------------------------------------------
# DATABASE
# ---------------------------------------------------------
DATABASE_URL=postgresql://postgres:password@localhost:5432/nmhirex

# ---------------------------------------------------------
# AUTHENTICATION
# ---------------------------------------------------------
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---------------------------------------------------------
# WHATSAPP INTEGRATION GATEWAY
# ---------------------------------------------------------
# Gateway base URL (no trailing slash)
NMHIREX_GATEWAY_URL=https://whatsapp-gateway.example.com
# API Key in the format: wa_live_<keyId>_<secret>
NMHIREX_API_KEY=wa_live_exampleKeyId_exampleSecret
# Request timeout in seconds (15-30s)
NMHIREX_GATEWAY_TIMEOUT_SECONDS=25
# Default Requisition ID fallback
NMHIREX_DEFAULT_REQUISITION_ID=506

# ---------------------------------------------------------
# FRONTEND / CORS
# ---------------------------------------------------------
FRONTEND_URL=http://localhost:5173

